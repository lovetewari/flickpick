{
  "name": "flickpick",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run tests/unit tests/integration",
    "test:watch": "vitest tests/unit tests/integration",
    "test:db": "vitest run tests/db --testTimeout=180000 --hookTimeout=180000",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:db && npm run test:e2e",
    "seed": "node scripts/seed-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.2",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "pg": "^8.22.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.18"
  }
